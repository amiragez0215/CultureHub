DB_PASSWORD=change-local-mysql-password
JWT_SECRET=replace-this-with-a-random-secret-at-least-32-characters
DEMO_PASSWORD=123
XXL_JOB_TOKEN=change-job-token
# Main API reads project-root .env on startup; environment variables take precedence.
# DeepSeek chat: AI_BASE_URL=https://api.deepseek.com, AI_CHAT_MODEL=deepseek-flash,
# AI_CHAT_PROVIDER=openai, SPRING_PROFILES_ACTIVE=deepseek (non-thinking, bounded output).
# Use unquoted values. Switch chat provider to openai after filling your provider's key/model/base URL.
AI_VECTORSTORE=none
AI_CHAT_PROVIDER=none
AI_EMBEDDING_PROVIDER=none
AI_API_KEY=not-configured
AI_BASE_URL=https://api.openai.com
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# Optional separate embedding credentials; unset means reuse chat key and URL.
# AI_EMBEDDING_API_KEY=your-embedding-key
# AI_EMBEDDING_BASE_URL=https://your-embedding-service
CHROMA_HOST=http://localhost
CHROMA_PORT=8000
